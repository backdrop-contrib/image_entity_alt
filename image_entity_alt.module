<?php
/**
 * @file
 * Alternative text for images that is stored in file entities.
 */

/**
 * Implements hook_preprocess_field().
 */
function image_entity_alt_preprocess_field(&$variables) {
  $element = $variables['element'];
  if ($element['#field_type'] !== 'image' || !image_entity_alt_instance_enabled($element['#entity_type'], $element['#field_name'], $element['#bundle'])) {
    return;
  }

  foreach ($variables['items'] as $delta => &$item) {
    if (isset($item['#item']) && (!isset($item['#item']['alt']) || $item['#item']['alt'] === '') && !empty($element['#items'][$delta]['fid'])) {
      $file = file_load($element['#items'][$delta]['fid']);
      if ($file) {
        // The image theme escapes the attribute; safe_value would escape twice.
        $item['#item']['alt'] = image_entity_alt_file_alt($file, $element['#language']);
      }
    }
  }
}



/**
 * Returns the machine name of the file-entity field that stores ALT text.
 *
 * Configurable via the settings form; defaults to 'field_alt'. See issue #1.
 */
function image_entity_alt_field_name() {
  return config_get('image_entity_alt.settings', 'alt_field_name') ?: 'field_alt';
}

/**
 * Implements hook_config_info().
 */
function image_entity_alt_config_info() {
  return array(
    'image_entity_alt.settings' => array(
      'label' => t('Image ALT from File entity settings'),
      'group' => t('Configuration'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function image_entity_alt_menu() {
  $items = array();
  $items['admin/config/media/image-entity-alt'] = array(
    'title' => 'Image ALT from File entity',
    'description' => 'Configure which field on the Image file entity stores ALT text.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('image_entity_alt_settings_form'),
    'access arguments' => array('administer site configuration'),
    'file' => 'image_entity_alt.admin.inc',
  );
  return $items;
}

/**
 * Returns unescaped file ALT text in the requested display language.
 */
function image_entity_alt_file_alt($file, $langcode = NULL) {
  $items = field_get_items('file', $file, image_entity_alt_field_name(), $langcode);
  return isset($items[0]['value']) ? $items[0]['value'] : '';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function image_entity_alt_form_filter_format_editor_image_form_alter(&$form, &$form_state) {
  $form['#after_build'][] = 'image_entity_alt_editor_after_build';
}

/**
 * Prefills editor ALT after the managed file element resolves the selected file.
 */
function image_entity_alt_editor_after_build($form, &$form_state) {
  $fid = isset($form['image']['fid']['#value']) ? $form['image']['fid']['#value'] : NULL;
  if (is_array($fid)) {
    $fid = isset($fid['fid']) ? $fid['fid'] : reset($fid);
  }
  // Preserve submitted text, including an explicitly empty decorative ALT.
  if (!$fid || $form['alt']['#value'] !== '' || isset($form_state['input']['attributes']['alt'])) {
    return $form;
  }
  $file = file_load($fid);
  if ($file) {
    $alt = image_entity_alt_file_alt($file);
    $form['alt']['#default_value'] = $alt;
    $form['alt']['#value'] = $alt;
    form_set_value($form['alt'], $alt, $form_state);
  }
  return $form;
}

/**
 * Returns TRUE when the given image field instance should use file-entity ALT.
 *
 * Defaults to TRUE so existing fields keep working. See issue #3.
 */
function image_entity_alt_instance_enabled($entity_type, $field_name, $bundle) {
  $instance = field_info_instance($entity_type, $field_name, $bundle);
  if ($instance && isset($instance['settings']['image_entity_alt'])) {
    return (bool) $instance['settings']['image_entity_alt'];
  }
  return TRUE;
}

/**
 * Implements hook_field_widget_form_alter().
 */
function image_entity_alt_field_widget_form_alter(&$element, &$form_state, $context) {
  $instance = $context['instance'];
  if ($context['field']['type'] !== 'image' || !image_entity_alt_instance_enabled($instance['entity_type'], $instance['field_name'], $instance['bundle'])) {
    return;
  }

  // Core's image widget handles its own deltas, including AJAX rebuilds.
  foreach (element_children($element) as $delta) {
    if (isset($element[$delta]['#process']) && in_array('image_field_widget_process', $element[$delta]['#process'])) {
      $element[$delta]['#process'][] = 'image_entity_alt_widget_process';
    }
  }
}

/**
 * Supplies the fallback after core builds the image widget's ALT element.
 */
function image_entity_alt_widget_process($element, &$form_state, $form) {
  if (empty($element['fid']['#value']) || !isset($element['alt'])) {
    return $element;
  }
  $file = file_load($element['fid']['#value']);
  if (!$file) {
    return $element;
  }
  $alt = image_entity_alt_file_alt($file, $element['#language']);
  if ($alt !== '' && $element['alt']['#default_value'] === '') {
    $element['alt']['#default_value'] = $alt;
  }
  // Child validation (including required ALT) runs before this callback.
  $element['#image_entity_alt'] = $alt;
  $element['#element_validate'][] = 'image_entity_alt_widget_validate';
  return $element;
}

/**
 * Avoids storing a copy of the fallback on the referencing entity.
 */
function image_entity_alt_widget_validate($element, &$form_state) {
  if (isset($element['alt']['#value']) && $element['alt']['#value'] === $element['#image_entity_alt']) {
    form_set_value($element['alt'], '', $form_state);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for field_ui_field_edit_form().
 *
 * Adds a per-instance checkbox to opt an image field in or out of file-entity
 * ALT replacement. See issue #3.
 */
function image_entity_alt_form_field_ui_field_edit_form_alter(&$form, &$form_state) {
  if ($form['#field']['type'] == 'image') {
    $instance = $form['#instance'];
    $form['instance']['settings']['image_entity_alt'] = array(
      '#type' => 'checkbox',
      '#title' => t('Use global ALT text from the file entity'),
      '#default_value' => isset($instance['settings']['image_entity_alt']) ? $instance['settings']['image_entity_alt'] : TRUE,
      '#description' => t('If checked, the ALT text for this field is pulled from the file entity when the per-instance ALT text is empty.'),
      '#weight' => 12,
    );
  }
}

/**
 * Implements hook_file_view_alter().
 */
function image_entity_alt_file_view_alter(&$build) {
  $file = $build['#file'];
  if ($file->type !== 'image' || empty($build['file'])) {
    return;
  }
  $alt = image_entity_alt_file_alt($file, $build['#language']);
  // Core's default file display reuses the image field formatter.
  if (isset($build['file']['#item']) && (!isset($build['file']['#item']['alt']) || $build['file']['#item']['alt'] === '')) {
    $build['file']['#item']['alt'] = $alt;
  }
  // Also support the legacy file_image formatter.
  if (isset($build['file']['#alt']) && $build['file']['#alt'] === '') {
    $build['file']['#alt'] = $alt;
  }
}
