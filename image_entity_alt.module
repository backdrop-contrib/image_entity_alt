<?php
/**
 * @file
 * Alternative text for images that is stored in file entities.
 */

/**
 * Prepare variables for field templates.
 * - Updates the ALT text on image fields to pull from the file entity field.
 * - Falls back to
 *
 * @see field.tpl.php
 */
function image_entity_alt_preprocess_field(&$variables) {
  // @todo - build a UI to select all vs some fields.
  if ($variables['element']['#field_type'] == 'image') {
    $lang = LANGUAGE_NONE;
    $alt_field = image_entity_alt_field_name();

    $alt = $variables['element']['#items'][0][$alt_field][$lang][0]['safe_value'];
    $variables['items'][0]['#item']['alt'] = $alt;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function image_entity_alt_form_node_form_alter(&$form, &$form_state) {
  // @todo - build a UI to select all vs some fields.
  $image_fields = field_read_fields(array('type' => 'image'));
  $image_field_names = array_keys($image_fields);
  $form['image_entity_alts'] = array(
    '#type' => 'value',
    '#value' => array_fill_keys($image_field_names, ''),
  );

  $lang = LANGUAGE_NONE;
  $alt_field = image_entity_alt_field_name();

  $form_keys = array_keys($form);
  foreach ($form_keys as $key) {
    $field_name = $key;
    if (in_array($field_name, $image_field_names)) {
      foreach ($form[$field_name][$lang] as $delta => $image) {
        if (isset($image['#default_value'][$alt_field])) {
                $file_alt = $image['#default_value'][$alt_field][$lang][0]['safe_value'];
          $form['image_entity_alts']['#value'][$field_name] = $file_alt;
          $form[$field_name][$lang][$delta]['#default_value']['alt'] = $file_alt;
        }
      }
    }
  }

  $form['#validate'][] = 'image_entity_alt_form_node_form_validate';
}

/**
 * Validate handler. Do not save File entity values in node instance.
 *
 * @see image_entity_alt_form_node_form_alter.
 */
function image_entity_alt_form_node_form_validate(&$form, &$form_state) {
  $lang = LANGUAGE_NONE;
  $image_entity_alts = $form_state['values']['image_entity_alts'];

  $value_keys = array_keys($form_state['values']);
  foreach ($value_keys as $key) {
    if (array_key_exists($key, $image_entity_alts)) {
      $submitted = trim($form_state['values'][$key][$lang][0]['alt']);
      if ($submitted == trim($image_entity_alts[$key])) {
        $form_state['values'][$key][$lang][0]['alt'] = '';
      }
    }
  }
}

/**
 * Returns the machine name of the file-entity field that stores ALT text.
 *
 * Configurable via the settings form; defaults to 'field_alt'. See issue #1.
 */
function image_entity_alt_field_name() {
  return config_get('image_entity_alt.settings', 'alt_field_name') ?: 'field_alt';
}

/**
 * Implements hook_config_info().
 */
function image_entity_alt_config_info() {
  return array(
    'image_entity_alt.settings' => array(
      'label' => t('Image ALT from File entity settings'),
      'group' => t('Configuration'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function image_entity_alt_menu() {
  $items = array();
  $items['admin/config/media/image-entity-alt'] = array(
    'title' => 'Image ALT from File entity',
    'description' => 'Configure which field on the Image file entity stores ALT text.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('image_entity_alt_settings_form'),
    'access arguments' => array('administer site configuration'),
    'file' => 'image_entity_alt.admin.inc',
  );
  return $items;
}

/**
 * Returns unescaped file ALT text in the requested display language.
 */
function image_entity_alt_file_alt($file, $langcode = NULL) {
  $items = field_get_items('file', $file, image_entity_alt_field_name(), $langcode);
  return isset($items[0]['value']) ? $items[0]['value'] : '';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function image_entity_alt_form_filter_format_editor_image_form_alter(&$form, &$form_state) {
  $form['#after_build'][] = 'image_entity_alt_editor_after_build';
}

/**
 * Prefills editor ALT after the managed file element resolves the selected file.
 */
function image_entity_alt_editor_after_build($form, &$form_state) {
  $fid = isset($form['image']['fid']['#value']) ? $form['image']['fid']['#value'] : NULL;
  if (is_array($fid)) {
    $fid = isset($fid['fid']) ? $fid['fid'] : reset($fid);
  }
  // Preserve submitted text, including an explicitly empty decorative ALT.
  if (!$fid || $form['alt']['#value'] !== '' || isset($form_state['input']['attributes']['alt'])) {
    return $form;
  }
  $file = file_load($fid);
  if ($file) {
    $alt = image_entity_alt_file_alt($file);
    $form['alt']['#default_value'] = $alt;
    $form['alt']['#value'] = $alt;
    form_set_value($form['alt'], $alt, $form_state);
  }
  return $form;
}
